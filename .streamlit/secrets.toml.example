# このファイルを .streamlit/secrets.toml にコピーして値を入れる（secrets.toml は .gitignore 済み。push しない）
# Streamlit Community Cloud では Settings > Secrets に同じ内容を貼り付ける
[github]
token     = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"   # repo スコープの Personal Access Token
repo_name = "your-username/NPB-Expected-Run-Value-Prediction"
branch    = "main"
